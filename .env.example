APP_NAME=ExamSphere
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=examsphere
DB_USERNAME=root
DB_PASSWORD=

# ─── Redis ───────────────────────────────────────────────────────────────────
# Install: https://redis.io  |  Windows: https://github.com/tporadowski/redis
#
# PHP client — IMPORTANT:
#   Production:  phpredis (C extension, persistent connections per FPM worker)
#                apt install php8.3-redis && phpenmod redis
#                systemctl restart php8.3-fpm
#                Significantly lower TCP overhead at 10,000+ concurrent students.
#
#   Local dev:   predis (pure PHP, no extension needed — works in Laragon/Docker)
#                Set REDIS_CLIENT=predis in your local .env
#
# Default is phpredis. Override with REDIS_CLIENT=predis for local dev only.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Separate Redis databases so cache / queue / session never share key-space
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# ─── Cache ───────────────────────────────────────────────────────────────────
# Use 'redis' in production; 'file' is fine for local dev
CACHE_STORE=redis

# ─── Queue ───────────────────────────────────────────────────────────────────
# Use 'redis' in production; 'database' is fine for local dev
QUEUE_CONNECTION=redis

# ─── Session ─────────────────────────────────────────────────────────────────
# Use 'redis' in production; 'database' is fine for local dev
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ─── Broadcast ───────────────────────────────────────────────────────────────
BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@examsphere.in"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS (optional for file storage) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Sanctum ─────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# ─── Horizon (Queue Dashboard) ───────────────────────────────────────────────
# Access at /horizon  —  restrict in production via HORIZON_ALLOWED_IPS
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_ALLOWED_IPS=

# ─── Feature 7: Failure Recovery & Circuit Breakers ─────────────────────────
# Circuit breaker failure thresholds (consecutive failures before circuit opens)
CB_REDIS_FAILURE_THRESHOLD=5
CB_REDIS_RESET_TIMEOUT=30
CB_REDIS_SUCCESS_THRESHOLD=2
CB_MYSQL_FAILURE_THRESHOLD=3
CB_MYSQL_RESET_TIMEOUT=60
CB_MYSQL_SUCCESS_THRESHOLD=1
CB_QUEUE_FAILURE_THRESHOLD=10
CB_QUEUE_RESET_TIMEOUT=60
CB_QUEUE_SUCCESS_THRESHOLD=3

# Job retry policies
RETRY_SCORING_TRIES=5
RETRY_SCORING_WINDOW_MIN=30
RETRY_RANKING_TRIES=3
RETRY_RANKING_WINDOW_MIN=60

# Dead Letter Queue (DLQ) settings
DLQ_ALERT_THRESHOLD=5
DLQ_AUTO_RETRY_DELAY=900
DLQ_LOG_RETENTION_DAYS=30

# Recovery monitoring thresholds
MONITOR_FAILED_CRITICAL_WARN=5
MONITOR_FAILED_CRITICAL_ALERT=20
MONITOR_RESULTS_QUEUE_WARN=500
MONITOR_RESULTS_QUEUE_ALERT=2000
MONITOR_REDIS_PING_WARN=10
MONITOR_LOG_RETENTION_DAYS=7

# ─── Load Testing (Local / Staging ONLY) ─────────────────────────────────────
# Disables the login rate limiter so k6 can ramp to 20k VUs without 429 errors.
# BOTH conditions must be true to take effect: APP_ENV=local AND this = true.
# Setting this to true in APP_ENV=production has ZERO effect (hard-coded guard).
LOAD_TEST_BYPASS_THROTTLE=false

# ─── Telescope (Dev Only) ────────────────────────────────────────────────────
# Only installed in require-dev; never enable in APP_ENV=production
TELESCOPE_ENABLED=false

# ─── Institution trial defaults ─────────────────────────────────────────────
TRIAL_STUDENT_LIMIT=50
TRIAL_FACULTY_LIMIT=3
TRIAL_QUESTION_LIMIT=5000
TRIAL_DURATION_DAYS=30

# ─── Super admin credentials (set on first deploy) ───────────────────────────
SUPER_ADMIN_EMAIL=admin@examsphere.in
SUPER_ADMIN_PASSWORD=

# ─── QR code storage ─────────────────────────────────────────────────────────
QRCODE_PATH=qrcodes

VITE_APP_NAME="${APP_NAME}"
