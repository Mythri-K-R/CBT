# ExamSphere — MySQL Production Configuration
# Apply by copying to /etc/mysql/conf.d/examsphere.cnf (or equivalent)
# and restarting MySQL: sudo systemctl restart mysql
#
# CRITICAL: All settings below must be applied before the first live exam.
# Default values (in parentheses) fail above 3,000 concurrent students.
#
# Test that settings applied: mysql -u root -e "SHOW VARIABLES LIKE 'innodb_buffer_pool_size';"

[mysqld]

# ── CR-2: InnoDB Buffer Pool ──────────────────────────────────────────────────
# Default: 134217728 (128 MB) — catastrophically undersized for exam load.
# At 5,000 students the active test_responses working set exceeds 128 MB;
# every DB write then requires a page read from disk first.
# Set to 60-70% of server RAM. For a 32 GB server use 20G; 64 GB use 40G.
innodb_buffer_pool_size = 16G

# Allows the buffer pool to be divided into multiple instances,
# reducing internal latch contention under high concurrency.
innodb_buffer_pool_instances = 8

# ── CR-2: Write throughput ceiling ───────────────────────────────────────────
# Default: 1 (fsync on every COMMIT) — limits writes to ~1,500/s on SATA SSD.
# Setting to 2 batches redo log fsyncs to once per second.
# Trade-off: up to 1 second of committed data can be lost on hard server crash.
# Acceptable here because Redis (ExamStateCacheService) independently caches
# the last 30 s of timer state and can reconstruct in-progress exam data.
innodb_flush_log_at_trx_commit = 2

# Larger log files reduce checkpoint frequency under write-heavy loads.
innodb_log_file_size = 512M

# ── CR-2: I/O capacity — match to actual disk capability ─────────────────────
# Default: 200 (designed for rotating HDDs). NVMe SSDs sustain 10,000+ IOPS.
# Undervaluing this causes InnoDB to unnecessarily throttle background writes.
innodb_io_capacity     = 4000
innodb_io_capacity_max = 8000

# ── CR-4: Connection limit ────────────────────────────────────────────────────
# Default: 151 — insufficient when php-fpm pm.max_children = 500.
# Above ~120 concurrent FPM workers MySQL returns "Too many connections".
# Set to: php-fpm max_children + Horizon workers + 50 admin headroom.
# For 500 FPM + 80 Horizon workers: 500 + 80 + 50 = 630 → round to 700.
max_connections = 700

# Reserve an admin port for DBA/ops access exempt from max_connections.
# Available since MySQL 8.0.14. Connect during a connection-pool emergency:
#   mysql --protocol=tcp --host=127.0.0.1 --port=33062 -u root -p
# This port accepts connections even when max_connections is fully exhausted.
# NOTE: extra_connection_limit_per_user is NOT a valid MySQL 8.0 parameter;
# it causes MySQL to refuse to start with an "unknown variable" error.
admin_address = 127.0.0.1
admin_port    = 33062

# ── Slow query logging ────────────────────────────────────────────────────────
# Surfaces regressions before they affect students.
slow_query_log         = ON
slow_query_log_file    = /var/log/mysql/slow.log
long_query_time        = 0.5
log_queries_not_using_indexes = ON
