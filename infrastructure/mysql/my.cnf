# ============================================================================
# MySQL 8.0 Configuration — CBT Platform (ExamSphere)
#
# LOAD-TEST MEASUREMENTS that drove these values:
#   MySQL write rate at 20k users:  ~4,000 ops/s
#     (save-response = 2 ops: SELECT lockForUpdate + UPDATE test_responses)
#   MySQL read rate:                ~2,000 ops/s
#     (timer-sync = 1 SELECT from Redis cache — usually skipped;
#      cold-path hits DB = ~10% of 667/s = ~67 reads/s)
#   Connection pool:
#     PHP-FPM 600 workers × 1 connection each    = 600
#     Horizon 80 workers   × 1 connection each   = 80
#     Monitoring / admin tools                   = 20
#     Total max_connections recommended          = 700
#
# TIER REFERENCE — change innodb_buffer_pool_size and max_connections:
#
#   Tier     | Server RAM | buffer_pool_size | max_connections | thread_pool
#   ---------|------------|------------------|-----------------|------------
#   1k users |    16 GB   |      6 GB        |       150       |      8
#   5k users |    32 GB   |     16 GB        |       250       |     16
#  10k users |    64 GB   |     32 GB        |       400       |     24
#  20k users |   128 GB   |     80 GB        |       700       |     32
#
# INSTALL:
#   cp my.cnf /etc/mysql/mysql.conf.d/cbt.cnf
#   systemctl restart mysql
#   Verify: SHOW VARIABLES LIKE 'innodb_buffer_pool_size';
# ============================================================================

[mysqld]

# ── Basic ──────────────────────────────────────────────────────────────────
pid-file    = /var/run/mysqld/mysqld.pid
socket      = /var/run/mysqld/mysqld.sock
datadir     = /var/lib/mysql
log-error   = /var/log/mysql/error.log
user        = mysql

# ── Character set ─────────────────────────────────────────────────────────
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# ── Network ───────────────────────────────────────────────────────────────
bind-address          = 0.0.0.0   # restrict to app server IP in production
port                  = 3306
max_connections       = 700       # scale per tier (see table above)
max_connect_errors    = 10000
wait_timeout          = 60        # drop idle connections after 60 s
interactive_timeout   = 60
connect_timeout       = 10

# ── Thread pool (MariaDB / Percona only — comment out on vanilla MySQL) ────
# thread_pool_size = 32         # match CPU core count on DB server
# thread_pool_stall_limit = 100

# ── InnoDB: buffer pool ────────────────────────────────────────────────────
# The buffer pool holds hot data pages in memory. When an InnoDB page is
# accessed, MySQL checks the pool first. A hit avoids disk I/O entirely.
#
# At 20k users with 4,000 ops/s targeting test_responses:
#   - test_responses has ~20k rows × 180 questions = 3.6 M rows during an exam
#   - avg row size ~256 bytes → 3.6 M × 256 = ~900 MB of hot data
#   - With indexes (idx_attempt_question etc.) + InnoDB overhead: ~4 GB
#   - 80 GB pool ensures the ENTIRE working set fits in memory.
#     On a dedicated MySQL server with 128 GB RAM, 80 GB leaves 48 GB for
#     OS + redo log + temp tables.
#
# Formula: buffer_pool_size = server_RAM × 0.625 (for dedicated MySQL host)
#
innodb_buffer_pool_size        = 80G    # 20k tier; see table for smaller tiers

# Use multiple buffer pool instances to reduce mutex contention.
# Rule: 1 instance per GB up to 8; then keep at 8-16.
innodb_buffer_pool_instances   = 16

# ── InnoDB: redo log ──────────────────────────────────────────────────────
# Larger redo log = fewer log flushes = higher write throughput.
# At 4,000 ops/s, a 2 GB redo log covers ~30 minutes of writes before
# needing a checkpoint, reducing I/O spikes during heavy exam periods.
# MySQL 8 uses innodb_redo_log_capacity (replaces innodb_log_file_size).
innodb_redo_log_capacity       = 4G     # MySQL 8.0.30+
# For MySQL < 8.0.30 use:
# innodb_log_file_size          = 1G
# innodb_log_files_in_group     = 4

# ── InnoDB: durability vs. performance ────────────────────────────────────
# innodb_flush_log_at_trx_commit:
#   1 = flush + fsync on every commit (full durability; slowest)
#   2 = flush to OS buffer on every commit, fsync every second (recommended)
#   0 = write + flush every second (fastest, data loss risk)
#
# At 4,000 commits/s, setting to 1 forces 4,000 fsyncs/s. On non-NVMe
# storage this saturates I/O. Setting to 2 risks losing at most 1 second
# of data on OS crash but not on MySQL crash. Acceptable for a CBT platform
# with session recovery (Feature 3: offline sync) and circuit breakers (Feature 7).
innodb_flush_log_at_trx_commit = 2

# Flush method: O_DIRECT bypasses OS buffer cache for data files.
# Prevents double-buffering (OS cache + InnoDB buffer pool).
innodb_flush_method            = O_DIRECT

# ── InnoDB: lock settings ──────────────────────────────────────────────────
# Bottleneck #6: TestSubmitService uses lockForUpdate() on TestAttempt rows.
# At 4,000 submissions/min, slow lock waits pile up.
# Fast-fail at 5s (not default 50s) so Horizon workers don't pile up waiting.
innodb_lock_wait_timeout       = 5

# Row-level locking for better concurrency (not table-level)
innodb_autoinc_lock_mode       = 2   # interleaved — best concurrency

# ── InnoDB: I/O capacity ──────────────────────────────────────────────────
# Tune to your storage IOPS. SSD: 2000–4000. NVMe: 10000–20000.
# Too low: background flushing lags; buffer pool dirty pages build up.
# Too high: background I/O starves foreground queries.
innodb_io_capacity             = 2000
innodb_io_capacity_max         = 4000

# Parallel read threads for InnoDB table scans (report queries, rankings)
innodb_read_io_threads         = 8
innodb_write_io_threads        = 8

# ── Query cache (MySQL 8 removed it) ─────────────────────────────────────
# Query cache is gone in MySQL 8. Redis serves the caching role (Feature 2).

# ── Slow query log ────────────────────────────────────────────────────────
# Capture any query > 100 ms for investigation.
slow_query_log                 = 1
slow_query_log_file            = /var/log/mysql/slow.log
long_query_time                = 0.1
log_queries_not_using_indexes  = 1    # also capture full-table scans

# ── Binary log (replication / point-in-time recovery) ────────────────────
# Enable if you add a read replica (Feature 8). Comment out if standalone.
# log_bin                        = /var/log/mysql/binlog
# binlog_format                  = ROW
# binlog_row_image               = MINIMAL    # write only changed columns
# expire_logs_days               = 7
# max_binlog_size                = 256M
# sync_binlog                    = 1          # fsync binlog per commit (safe)

# ── Temp tables ──────────────────────────────────────────────────────────
# CalculateTestRankings runs GROUP BY + ORDER BY on large result sets.
# Keep tmp tables in memory where possible.
tmp_table_size                 = 256M
max_heap_table_size            = 256M

# ── Sort / join buffers ───────────────────────────────────────────────────
# Per-session buffers — allocated on demand, not globally.
# Set conservatively: 600 connections × 4 MB = 2.4 GB max if all sort.
sort_buffer_size               = 4M
join_buffer_size               = 4M
read_rnd_buffer_size           = 2M

# ── Table cache ───────────────────────────────────────────────────────────
# CBT schema: ~30 tables. Allow 700 connections × 2 open tables = 1400.
table_open_cache               = 4000
table_definition_cache         = 2000

# ── Connection / packet limits ────────────────────────────────────────────
max_allowed_packet             = 64M   # allow large exam JSON imports

# ── Performance schema (minimal overhead in production) ───────────────────
performance_schema             = ON
performance_schema_instrument  = 'wait/%=ON'  # enable wait instrumentation

[client]
socket    = /var/run/mysqld/mysqld.sock
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
